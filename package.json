{
  "name": "gearmod",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "author": {
    "name": "Francisco Lucas Lima Sena"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "postinstall": "pnpm --filter @gearmod/desktop rebuild:native",
    "dev": "pnpm --filter @gearmod/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dist": "pnpm --filter @gearmod/desktop dist",
    "dist:linux": "pnpm --filter @gearmod/desktop dist:linux",
    "dist:mac": "pnpm --filter @gearmod/desktop dist:mac",
    "notices": "node scripts/third-party-notices.mjs",
    "codex:types": "node scripts/generate-codex-types.mjs"
  }
}

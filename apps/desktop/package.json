{
  "name": "@gearmod/desktop",
  "version": "0.4.0",
  "description": "Kanban board that runs AI coding agents on each card",
  "homepage": "https://github.com/flucassena/gearmod",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "author": {
    "name": "Francisco Lucas Lima Sena",
    "email": "sena.franciscolucas@gmail.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "pnpm run rebuild:native",
    "dev": "electron-vite dev",
    "rebuild:native": "electron-rebuild -f -o better-sqlite3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "posttest": "pnpm run rebuild:native",
    "prebuild": "pnpm run rebuild:native",
    "build": "electron-vite build",
    "dist": "pnpm run build && electron-builder --win nsis",
    "dist:linux": "pnpm run build && electron-rebuild -f -o node-pty && electron-builder --linux AppImage deb",
    "dist:mac": "pnpm run build && electron-rebuild -f -a arm64 -o better-sqlite3,node-pty && electron-builder --mac --arm64 && electron-rebuild -f -a x64 -o better-sqlite3,node-pty && electron-builder --mac --x64 && pnpm run rebuild:native"
  },
  "dependencies": {
    "@gearmod/contracts": "workspace:*",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "better-sqlite3": "^12.4.1",
    "node-pty": "^1.1.0",
    "pg": "8.23.1",
    "pg-cursor": "2.22.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.38.0",
    "@lezer/highlight": "^1.2.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.3"
  },
  "build": {
    "appId": "dev.gearmod.desktop",
    "productName": "GearMod",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**",
      "node_modules/@vscode/tree-sitter-wasm/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/@vscode/tree-sitter-wasm/wasm/tree-sitter-{bash,css,ini,powershell,regex}.wasm"
    ],
    "extraResources": [
      {
        "from": "resources/gearmod-plugin",
        "to": "gearmod-plugin"
      },
      {
        "from": "resources/gearmod-mcp",
        "to": "gearmod-mcp"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      },
      {
        "from": "../../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "GearMod-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "executableName": "gearmod",
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Kanban board that runs AI coding agents on each card",
      "maintainer": "Francisco Lucas Lima Sena <sena.franciscolucas@gmail.com>",
      "artifactName": "GearMod-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "GearMod-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "GearMod-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GearMod uses the microphone for voice dictation in the chat."
      }
    },
    "dmg": {
      "artifactName": "GearMod-${version}-${arch}.${ext}"
    }
  }
}
